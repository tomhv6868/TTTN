  "execution_pipeline": {
    "mode": "checkpointed_hybrid",
    "replay_host": "ubuntu_24_04_vmware",
    "replay_workspace": "/mnt/hgfs/TTTN",
    "parquet_packaging_host": "windows_native",
    "dependency_mutation_allowed": false,
    "parquet_runtime": {
      "python_major_minor": "3.13",
      "pyarrow_exact_version": "23.0.1",
      "preflight_required": true
    },
    "resume_policy": "validate_content_addressed_capture_receipt_before_skip",
    "scratch_policy": "ubuntu_local_scratch_then_atomic_copy_to_workspace",
    "progress_heartbeat_seconds": 15,
    "silent_multi_hour_stage_allowed": false
  },
  "replay": {
    "shared_components": [
      "pcap_adapter",
      "packet_parser",
      "flow_table",
      "feature_engine"
    ],
    "checkpoint_schedule": [
      {"name": "F3", "packet_count": 3},
      {"name": "F5", "packet_count": 5},
      {"name": "F7", "packet_count": 7},
      {"name": "F9", "packet_count": 9}
    ],
    "triggering_packet_included": true,
    "emit_only_reached_checkpoints": true,
    "synthetic_terminal_checkpoint_allowed": false,
    "checkpoint_error_policy": "abort_capture",
    "parser_and_flow_ingest_drift_allowed": false,
    "temporary_replay_key": ["capture_id", "generation"],
    "sqlite_flow_id_source": "source_database.flow.flow_id",
    "generation_must_not_be_used_as_flow_id": true,
    "runtime_flow_instance_id_must_not_be_used_as_sqlite_flow_id": true,
    "close_record_exact_comparison_fields": [
      "capture_id",
      "export_ordinal",
      "protocol",
      "low_ip",
      "low_port",
      "high_ip",
      "high_port",
      "forward_source_ip",
      "forward_source_port",
      "generation",
      "creation_timestamp_ns",
      "last_capture_timestamp_ns",
      "last_event_timestamp_ns",
      "packet_count",
      "forward_packet_count",
      "reverse_packet_count",
      "close_reason"
    ],
    "float_serialization": "max_digits10_json_to_ieee754_little_endian_float64_blob",
    "staging": {
      "directory": "run_log/t3.5/checkpoints/snapshot-shards",
      "database_name": "snapshot-shard.sqlite3",
      "receipt_name": "receipt.json",
      "checkpoint_granularity": "one_capture",
      "application_id": 1311986515,
      "user_version": 1,
      "raw_packets_or_payload_stored": false
    }
  },
  "parquet": {
    "root": "run_log/t3.5/dataset-v1",
    "layout": "checkpoint={checkpoint}/capture_id={capture_id}/part-00000.parquet",
    "capture_commit_receipt": "run_log/t3.5/dataset-v1/capture-receipts/{capture_id}.json",
    "parts": 20,
    "rows_sorted_by": ["flow_id"],
    "compression": "zstd",
    "compression_level": 3,
    "writer_batch_rows": 16384,
    "row_group_rows": 65536,
    "dictionary_columns": ["capture_id", "assigned_class", "assignment_method"],
    "write_statistics": true,
    "atomic_publish": "temporary_sibling_then_replace_and_capture_receipt_commit_marker"
  },
  "row_schema": {
    "metadata_columns": [
      {"name": "flow_id", "type": "uint64"},
      {"name": "capture_id", "type": "string"},
      {"name": "checkpoint", "type": "uint8"},
      {"name": "flow_start_timestamp_ns", "type": "int64"},
      {"name": "checkpoint_timestamp_ns", "type": "int64"},
      {"name": "assigned_class", "type": "string"},
      {"name": "label_binary", "type": "bool", "rule": "assigned_class != 'BENIGN'"},
      {"name": "assignment_method", "type": "string"}
    ],
    "feature_columns": "exact ordered names from prerequisites.feature_schema",
    "feature_column_type": "float64",
    "feature_columns_non_null_and_finite": true,
    "model_input_allowlist": "exactly_the_54_feature_columns",
    "positional_model_column_selection_allowed": false,
    "forbidden_columns": [
      "generation",
      "export_ordinal",
      "protocol",
      "low_ip",
      "low_port",
      "high_ip",
      "high_port",
      "forward_source_ip",
      "forward_source_port",
      "candidate_label_ids",
      "final_flow_duration",
      "final_packet_count",
      "attack_schedule",
      "raw_packet",
      "payload"
    ]
  },
