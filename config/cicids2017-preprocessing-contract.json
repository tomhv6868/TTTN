  "preprocessing": {
    "input_dtype": "float64",
    "imputer": {
      "algorithm": "sklearn.impute.SimpleImputer",
      "strategy": "median",
      "missing_value": "NaN",
      "positive_or_negative_infinity": "fail_fast"
    },
    "constant_features": {
      "definition": "zero population variance after imputation on the profile training population",
      "action": "drop_and_persist_mask",
      "near_constant_action": "retain"
    },
    "scaler": {
      "algorithm": "sklearn.preprocessing.StandardScaler",
      "with_mean": true,
      "with_std": true,
      "fit_dtype": "float64"
    },
    "output_dtype": "float32",
    "operation_order": ["median_imputation", "constant_feature_mask", "standard_scaling", "float32_cast"]
  },
