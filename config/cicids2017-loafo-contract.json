  "checkpoints": ["F3", "F5", "F7", "F9"],
  "loafo_protocol": {
    "supervised_preprocessing": "refit for every holdout and checkpoint on train rows excluding the holdout family",
    "flow_rf": "refit on benign and non-holdout attack train rows",
    "rf_stacker": "refit on benign and non-holdout attack train rows; train anomaly meta-features come only from accepted T4.4 OOF rows after holdout filtering",
    "known_family_rf": "refit on non-holdout attack train rows with class order excluding the holdout",
    "anomaly_models": "reuse accepted T4.3 full benign-train HBOS and Isolation Forest models, normalization profiles and thresholds without refit",
    "unknown_evaluation": "all rows of the held-out family from train, validation and test become sealed unknown evaluation rows",
    "known_evaluation": "known validation and test rows retain their original partition and exclude the holdout family",
    "test_use": "metrics only after every preprocessing, fit, threshold and tree-count decision is frozen",
    "persist_model_objects": false,
    "reload_parity": "persist each temporary family model, reload and compare probabilities before deleting the temporary model"
  },
  "random_forest": {
    "implementation": "sklearn.ensemble.RandomForestClassifier",
    "topology": "the accepted T4.2/T4.5/T4.6 parameters remain exact except n_estimators selected by optimization_benchmark",
    "gpu_primary_training_allowed": false,
    "reason": "available GPU implementations change split construction or estimator family and therefore do not preserve the accepted Random Forest algorithm"
  },
  "optimization_benchmark": {
    "purpose": "select one globally frozen tree count before any LOAFO test scoring",
    "data": "accepted known validation only",
    "test_partition_allowed": false,
    "candidate_tree_counts": [50, 100, 150, 200, 300],
    "reference_tree_count": 300,
    "method": "cumulative first-N estimator probabilities from the accepted 300-tree T4.2, T4.5 and T4.6 bundles",
    "selection": "smallest candidate that passes every applicable gate for all three model roles and all four checkpoints; otherwise 300",
    "binary_gates": {
      "macro_f1_max_drop": 0.002,
      "attack_recall_max_drop": 0.002,
      "benign_fpr_max_increase": 0.0005
    },
    "multiclass_gates": {
      "macro_family_f1_max_drop": 0.002,
      "balanced_accuracy_max_drop": 0.002
    },
    "diagnostics": [
      "validation_log_loss_by_tree_count",
      "metric_values_and_deltas_by_tree_count",
      "wall_time_by_model_role_and_checkpoint",
      "selected_tree_count"
    ],
    "artifact": {
      "path": "run_log/t4.7/tree-convergence-benchmark.json",
      "format": "json",
      "overwrite_allowed": false
    }
  },
  "performance": {
    "materialize_raw_snapshot_once_per_checkpoint_and_family": true,
    "share_transformed_matrices_across_supervised_models": true,
    "score_accepted_anomaly_models_once_per_snapshot_population": true,
    "durable_restartable_family_stages": true,
    "maximum_families_per_execution_stage": 2
  },
  "required_outputs": {
    "per_family_checkpoint_predictions": "Parquet with stable capture_id/flow_id/group keys and all baseline, anomaly, stacker and known-family outputs",
    "per_family_receipt": "JSON with population accounting, leakage audit, metrics, timing, peak RAM and temporary reload parity",
    "aggregate_acceptance": "JSON with macro results for nine eligible families and separate four-family case studies",
    "report": "Vietnamese report with loss curves, ROC/PR, confusion matrices, recall/FPR heatmaps, feature importance, confidence distributions, training time, RAM and GPU utilization"
  },
  "validation": {
    "all_prerequisite_hashes_verified": true,
    "accepted_300_tree_probability_parity_required": true,
    "benchmark_selection_deterministic": true,
    "holdout_absent_from_every_supervised_fit": true,
    "anomaly_fit_population_benign_only": true,
    "flow_and_model_fit_leakage_zero": true,
    "test_labels_excluded_from_all_selection": true,
    "hooks_excluded": true
  }
